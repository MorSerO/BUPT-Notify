# 依赖与构建产物
node_modules/
.npm-cache/

# 本地配置与密钥（切勿提交）
config.json
config.json.bak
*.bak
.env

# 运行时状态（已转发记录、会话 Cookie、登录凭据）
data/
logs/
output/

# 安装时固化的本机 node.exe 路径（每台机器不同）
.node-path

# 自启安装时生成的隐藏启动器
scripts/run-hidden.vbs

# 用户手动保存的网页快照（体积大，仅用于本地调试解析器）
*_files/
tools/out/
*.html

# ...但下面这些 HTML 是程序的一部分，必须提交：
#   test/fixtures  —— 否则 clone 下来 npm test 会失败
#   src/ui         —— 否则 clone 下来控制面板是空白的
!test/fixtures/*.html
!src/ui/*.html

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# 发布脚本用的临时提交信息
commit-message.txt
.commit-message.txt
.commit-msg.tmp
